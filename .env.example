# Copy to `.env` (never commit). On Vercel set the same keys in Project → Settings → Environment Variables.

# Public site URL (no trailing slash). Production: your domain, e.g. https://tempemaknuk.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public: URL & anon key only)
# From: Supabase dashboard → Project Settings → API (Project URL, anon/public key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role — server only, never expose
# From: Supabase dashboard → Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=

# From: Supabase dashboard → Connect → Connection string (password = database password)
# Postgres — runtime via transaction pooler (port 6543, prepare: false)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Postgres — migrations via direct/session connection (port 5432)
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Secrets for protected route handlers (/api/cron/*, revalidate). Generate yourself, min. 16 chars:
#   openssl rand -hex 32
CRON_SECRET=
REVALIDATE_SECRET=

# Optional — local dev/build without the full env (never in production runtime)
# SKIP_ENV_VALIDATION=1

# Optional — Playwright E2E (tests/e2e). Admin specs are skipped without credentials.
# E2E_ADMIN_* = a dedicated editor account invited via Admin → Pengguna.
# E2E_BASE_URL=http://localhost:3100
# E2E_AXE_STRICT=1
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
